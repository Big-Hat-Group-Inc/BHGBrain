{
  "name": "@kkaminsk/bhgbrain",
  "version": "1.34.3",
  "description": "Persistent, vector-backed memory for MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bhgbrain": "dist/cli/index.js",
    "bhgbrain-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run.ts",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "memory",
    "brain",
    "vector",
    "qdrant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Big-Hat-Group-Inc/BHGBrain.git"
  },
  "homepage": "https://github.com/Big-Hat-Group-Inc/BHGBrain#readme",
  "bugs": {
    "url": "https://github.com/Big-Hat-Group-Inc/BHGBrain/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qdrant/js-client-rest": "~1.19.0",
    "commander": "^14.0.3",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.11"
  }
}
